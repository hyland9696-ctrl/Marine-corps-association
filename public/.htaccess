# St. Charles County Detachment 725 — Apache config for GoDaddy static hosting.
# This file is copied verbatim into the static export output and must be
# uploaded to the site's web root (e.g. public_html) alongside the pages.

# ----------------------------------------------------------------------------
# Canonical host: force HTTPS and the www subdomain (matches the canonical
# URL used in sitemap/robots/metadata). Remove either block if your GoDaddy
# setup already handles the redirect.
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force www
  RewriteCond %{HTTP_HOST} ^stcharlesmarines\.org$ [NC]
  RewriteRule ^ https://www.stcharlesmarines.org%{REQUEST_URI} [L,R=301]
</IfModule>

# ----------------------------------------------------------------------------
# Security headers (previously set in next.config.ts; static hosting has no
# Node server, so Apache serves them instead).
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formspree.io"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# ----------------------------------------------------------------------------
# Next.js generates the favicon and social share images as extensionless
# files (/icon, /opengraph-image, /twitter-image). Force their MIME type so
# Apache serves them as PNGs — otherwise browsers and Facebook/X reject them.
# ----------------------------------------------------------------------------
<Files "icon">
  ForceType image/png
</Files>
<Files "opengraph-image">
  ForceType image/png
</Files>
<Files "twitter-image">
  ForceType image/png
</Files>

# ----------------------------------------------------------------------------
# Custom 404 page (generated by the export as /404.html).
# ----------------------------------------------------------------------------
ErrorDocument 404 /404.html
