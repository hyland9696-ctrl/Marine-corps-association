# St. Charles County Detachment 725 — Apache config for GoDaddy static hosting.
# This file is copied verbatim into the static export output and must be
# uploaded to the site's web root (e.g. public_html) alongside the pages.

# ----------------------------------------------------------------------------
# Canonical host: force HTTPS and the www subdomain (matches the canonical
# URL used in sitemap/robots/metadata). Remove either block if your GoDaddy
# setup already handles the redirect.
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force www
  RewriteCond %{HTTP_HOST} ^stcharlesmarine\.com$ [NC]
  RewriteRule ^ https://www.stcharlesmarine.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ----------------------------------------------------------------------------
# Security headers (previously set in next.config.ts; static hosting has no
# Node server, so Apache serves them instead).
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://formspree.io https://script.google.com https://script.googleusercontent.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formspree.io https://script.google.com"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# ----------------------------------------------------------------------------
# Next.js generates the favicon and social share images as extensionless
# files (/icon, /apple-icon, /opengraph-image, and per-page
# /<page>/opengraph-image-<hash>). Force their MIME type so
# Apache serves them as PNGs — otherwise browsers and Facebook/X reject them.
# ----------------------------------------------------------------------------
<FilesMatch "^(icon|apple-icon|opengraph-image|twitter-image)(-[a-z0-9]+)?$">
  ForceType image/png
</FilesMatch>

# ----------------------------------------------------------------------------
# Hardening: no directory listings, no server version banner, and never serve
# repo housekeeping files (README.md etc.) or dotfiles that end up in the export.
# ----------------------------------------------------------------------------
Options -Indexes
ServerSignature Off
<FilesMatch "(?i)\.(md|gs|json\.bak|sh|ts|tsx|mjs|lock)$|^\.">
  Require all denied
</FilesMatch>
<Files "manifest.json">
  Require all denied
</Files>

# ----------------------------------------------------------------------------
# Compression and browser caching (big Lighthouse wins on shared hosting).
# Next.js hashes everything under /_next/static, so it can be cached for a year.
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/json application/javascript image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
# Custom 404 page (generated by the export as /404.html).
# ----------------------------------------------------------------------------
ErrorDocument 404 /404.html
